# Copia este archivo como ".env" (el archivo .env NO se sube a Git).
# Solo las variables que empiezan con EXPO_PUBLIC_ llegan a la app.

# --- Modo emuladores (desarrollo) ---
EXPO_PUBLIC_USAR_EMULADORES=true
# IP de tu PC en la red WiFi (ipconfig -> "Dirección IPv4"). Con Expo Go en celular NO sirve 127.0.0.1.
# Emulador de Android: 10.0.2.2
EXPO_PUBLIC_EMULADOR_HOST=192.168.1.100

# --- Proyecto Firebase (el mismo que usa "firebase use") ---
EXPO_PUBLIC_FIREBASE_PROJECT_ID=eventos-ensenada

# Solo hacen falta al usar Firebase real (consola -> Configuración del proyecto -> Tus apps -> Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Pon "false" solo para pruebas si no quieres verificar el correo al iniciar sesión
EXPO_PUBLIC_EXIGIR_CORREO_VERIFICADO=true
